#include <stdio.h>
#include <string.h>

int main() {
    char data[100], code[200];
    int m, r = 0, n, i, j, parity, error = 0;

    printf("Enter data bits: ");
    scanf("%s", data);

    m = strlen(data);

    // Calculate number of redundant bits
    while ((1 << r) < (m + r + 1))
        r++;

    n = m + r;

    // Initialize code array (1-indexed)
    for (i = 1; i <= n; i++)
        code[i] = '0';

    // Put data bits in non-power-of-2 positions
    j = 0;
    for (i = 1; i <= n; i++) {
        if ((i & (i - 1)) != 0) {
            code[i] = data[j++];
        }
    }

    // Calculate parity bits (even parity)
    for (i = 0; i < r; i++) {
        int pos = 1 << i;
        parity = 0;

        for (j = 1; j <= n; j++) {
            if ((j & pos) != 0 && j != pos) {
                if (code[j] == '1')
                    parity++;
            }
        }

        // Set parity bit to make total number of 1s even
        code[pos] = (parity % 2) ? '1' : '0';
    }

    printf("\nHamming Code: ");
    for (i = n; i >= 1; i--)
        printf("%c", code[i]);

    // Take received code
    char received[200];

    printf("\n\nEnter received Hamming code: ");
    scanf("%s", received);

    // Store received code in 1-indexed form
    char recv[200];
    for (i = 1; i <= n; i++)
        recv[i] = received[n - i];

    // Find error position
    error = 0;

    for (i = 0; i < r; i++) {
        int pos = 1 << i;
        parity = 0;

        for (j = 1; j <= n; j++) {
            if ((j & pos) != 0) {
                if (recv[j] == '1')
                    parity++;
            }
        }

        if (parity % 2)
            error += pos;
    }

    if (error == 0) {
        printf("No error detected.\n");
    } else {
        printf("Error detected at bit position: %d\n", error);

        // Correct the error
        recv[error] = (recv[error] == '0') ? '1' : '0';

        printf("Corrected Hamming Code: ");
        for (i = n; i >= 1; i--)
            printf("%c", recv[i]);
        printf("\n");
    }

    return 0;
}
