#include <stdio.h>

int main()
{
    int h[7], e, p1, p2, p4, pos;

    printf("Enter 4 data bits: ");
    scanf("%d%d%d%d", &h[2], &h[4], &h[5], &h[6]);

    // Calculate parity bits
    h[0] = h[2] ^ h[4] ^ h[6];
    h[1] = h[2] ^ h[5] ^ h[6];
    h[3] = h[4] ^ h[5] ^ h[6];

    printf("Hamming code: ");

    for (int i = 0; i < 7; i++)
        printf("%d", h[i]);

    printf("\nEnter error position (0-7): ");
    scanf("%d", &e);

    // Introduce error
    if (e)
        h[e - 1] ^= 1;

    // Check parity bits
    p1 = h[0] ^ h[2] ^ h[4] ^ h[6];
    p2 = h[1] ^ h[2] ^ h[5] ^ h[6];
    p4 = h[3] ^ h[4] ^ h[5] ^ h[6];

    // Find error position
    pos = p1 + (2 * p2) + (4 * p4);

    if (pos)
    {
        printf("Error at position: %d\n", pos);

        // Correct the error
        h[pos - 1] ^= 1;
    }
    else
    {
        printf("No error\n");
    }

    printf("Corrected code: ");

    for (int i = 0; i < 7; i++)
        printf("%d", h[i]);

    // Extract original data
    printf("\nOriginal Data: %d%d%d%d\n",
           h[2], h[4], h[5], h[6]);

    return 0;
}
